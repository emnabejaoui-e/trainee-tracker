<div class="card mb-4">
    <div class="card-header">
        JSON Import
    </div>

    <div class="card-body">
        <p class="card-text">
            Import lessons from a JSON file.
        </p>

        <form asp-controller="Teachingplan"
      asp-action="Upload"
      method="post"
      enctype="multipart/form-data">

    <div class="input-group">
        <input type="file"
               name="file"
               accept=".json"
               class="form-control" />

        <button type="submit"
                class="btn btn-primary">
            Import JSON
        </button>
    </div>
</form>
    </div>
</div>