@* Code-Owner: Andrej Basara *@
@model Trainee_Tracker.Models.Mentor
@{
    ViewData["Title"] = "CreateMentor";
}

<div class="user-create-forum-container">
    <h1 class="mb-4">Create Mentor</h1>
    <div class="row">
        <div class="col-12">
            <form asp-action="CreateMentor">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Name" type="name" class="form-control" id="floatingInput" placeholder=" ">
                    <label asp-for="Name" for="floatingInput">Name</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Email" type="email" class="form-control" id="floatingInput" placeholder=" ">
                    <label asp-for="Email" for="floatingInput">Email</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input name="password" type="password" class="form-control" id="floatingInput" placeholder=" ">
                    <label class="control-label for="floatingInput">Password</label>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn-user-create-confirm" />
                </div>
            </form>
        </div>
    </div>
    <div>
        <a asp-action="UserManagment" class = "grey-link" >Back to List</a>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}