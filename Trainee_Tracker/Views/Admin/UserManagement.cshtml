@* Code Owner: Andrej Basara *@
@model IList<Trainee_Tracker.Models.User>
@using Trainee_Tracker.Models

@{
    ViewData["Title"] = "Index";
}

<h2> </h2>
<div class = "user-table-main-container">
<p class="d-flex align-items-center gap-2">
    Create new:
    <a asp-action="CreateTrainee" class="btn-user-create">Trainee</a>
    <a asp-action="CreateMentor" class="btn-user-create">Mentor</a>
    <a asp-action="CreateAdmin" class="btn-user-create">Admin</a>
    <a asp-action="AssignMentor" class="btn-user-create ms-auto" >Assign Mentor</a>
</p>
<form asp-action="UserManagement" method="get">
    <div class="form-actions no-color">
        <p>
            <label>Find by: <input type="text" name="SearchString" value="@ViewData["CurrentFilter"]" placeholder="E-Mail/ Name"/></label>
            <input type="submit" value="Search" class="btn btn-outline-secondary btn-sm" style="position: relative; top: -2px;" /> |
            <a asp-action="UserManagement">Back to Full List</a>
        </p>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
                <th>Name</th>
                <th>E-Mail</th>
                <th>Role</th>
                <th>Status</th>
                <th>Start date</th>
                <th>Mentor</th>
                <th>Action</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @if (item is Trainee) {
                    <text> Trainee </text>
                } else if (item is Admin) {
                    <text> Admin </text>
                } else if (item is Mentor) {
                    <text> Mentor </text>
                }
            </td>
            <td>
                @(item.Closed ? "Closed" : "Active")
            </td>
            <td>
                @if (item is Trainee t) {
                @Html.DisplayFor(modelItem => t.StartingDate)
                }
            </td>
            <td>
                @if (item is Trainee t2) {
                    @string.Join(", ", t2.Mentors.Select(m => m.Name))
                }
            </td>
            <td>
                @{
                    var editAction = item is Trainee ? "UpdateTrainee" : "UpdateMentor";
                }
                <a asp-action="@editAction" asp-route-id="@item.Id" class = "grey-link">Edit</a> |
                <a asp-action="UserDetails" asp-route-id="@item.Id" class = "grey-link">Details</a> |
                <a asp-action="CloseUser" asp-route-id="@item.Id" class = "grey-link">Close</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>