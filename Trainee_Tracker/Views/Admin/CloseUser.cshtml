@* Code-Owner: Andrej Basara*@
@model Trainee_Tracker.Models.User
@{
    ViewData["Title"] = "CloseUser";
}
<div class="user-create-forum-container">
    <h3>Are you sure you want to close this user?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class = "col-sm-4">
                @Html.DisplayNameFor(model => model.Name):
            </dt>
            <dd class = "col-sm-8">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class = "col-sm-4">
                @Html.DisplayNameFor(model => model.Email):
            </dt>
            <dd class = "col-sm-8">
                @Html.DisplayFor(model => model.Email)
            </dd>
            @if (Model is Trainee t) {
            <dt class = "col-sm-4">
                Role:
            </dt>
            <dd class = "col-sm-8">
                Trainee
            </dd>
            }
        </dl>

        @if (ViewBag.IsLastAdmin is true) {
            <div class="mb-2" style="margin-top: 16px;">
                <div class="alert alert-danger" role="alert">
                    <strong>Warning:</strong> This is the last active admin account. If you close it, no one will be able to access the admin panel anymore!
                </div>
            </div>
        }
        
        <form asp-action="CloseUser">
            <input type="hidden" asp-for="Id" />
            <div class="mb-2" style="margin-top: 16px;">
                <input type="submit" value="Close User" class="btn btn-danger" />
            </div>
            <a asp-action="UserManagement">Back to List</a>
        </form>
    </div>
</div>