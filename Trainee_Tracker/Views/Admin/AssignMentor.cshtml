@* Code Owner: Andrej Basara *@
@{
    ViewData["Title"] = "AssignMentor";
}

<form method="post">
    @Html.AntiForgeryToken()
    <div class="user-create-forum-container">
        <h1 style="margin-bottom: 24px;">Assign Mentor to Trainee</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div style="color: #c0392b; margin-bottom: 16px;">
                @Html.ValidationSummary()
            </div>
        }

        <p>Mentor:
        <select name="mentorId">
        @foreach (var m in ViewBag.Mentors)
        {
            <option value="@m.Id">@m.Name</option>
        }
        </select>
        </p>

        <p> Trainee:
        <select name="traineeId">
            @foreach (var t in ViewBag.Trainees)
            {
                <option value="@t.Id">@t.Name</option>
            }
        </select>
        </p>
        <p> </p>
        <button type="submit" class="btn-user-create-confirm">Assign</button>
    </div>
</form>
