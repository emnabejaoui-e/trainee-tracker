@* Code-Owner: Andrej Basara*@
@model Trainee_Tracker.Models.User
@{
    ViewData["Title"] = "UserDetails";
}
<div class="user-create-forum-container">
    <h3>User Details</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Name):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Email):
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Email)
            </dd>
            @if (Model is Trainee_Tracker.Models.Trainee t)
            {
            <dt class="col-sm-4">
                Role:
            </dt>
            <dd class="col-sm-8">Trainee</dd>

            <dt class="col-sm-4">Starting Date:</dt>
            <dd class="col-sm-8">@t.StartingDate</dd>
            
            <dt class="col-sm-4">End Date:</dt>
            <dd class="col-sm-8">@t.EndDate</dd>
            }
        </dl>
    </div>
</div>