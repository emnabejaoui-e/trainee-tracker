@* Code Owner: Julia Sandner *@

@model Trainee_Tracker.Models.ProgressControlData
@{
    ViewData["Title"] = "ProgressControl";
}


<div class="progress-page">

    <div class="screen">
        <div class="page-content">
            <div class="page-titlebar">
                <h2>Progress of @ViewBag.TraineeName</h2>
            </div>

            <div class="info-box">
                <div class="info-label">Progress Statistics</div>

                <div>Days worked: <strong>@Model.DaysWorked.ToString("0.##")</strong></div>
                <div>Finished estimate: <strong>@Model.Finished</strong></div>
                <div>Open estimate: <strong>@Model.Open</strong></div>
                <div>Buffer: <strong>@Model.Buffer</strong></div>
                <div>Speed: <strong>@Model.Speed %</strong></div>
                <div>Predicted Buffer: <strong>@Model.PredictedBuffer</strong></div>
            </div>

      

           

            @if (User.IsInRole("Trainee"))
            {
                <a asp-controller="Trainee" asp-action="WeekPlan" style="display:inline-block;
                    margin-top:12px;
                    padding:8px 13px;
                    border:1px solid #FF0844 !important;
                    border-radius:5px;
                    background-color:#FF0844 !important;
                    color:#FFFFFF !important;
                    text-decoration:none !important;">
                    Back to overview
                </a>
            }
            else
            {
                <a asp-controller="Mentor" asp-action="MyTrainees" style="display:inline-block;
                    margin-top:12px;
                    padding:8px 13px;
                    border:1px solid #FF0844 !important;
                    border-radius:5px;
                    background-color:#FF0844 !important;
                    color:#FFFFFF !important;
                    text-decoration:none !important;">
                    Back to overview
                </a>
            }
        </div>
    </div>
</div>