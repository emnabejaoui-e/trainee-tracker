@model Trainee_Tracker.Models.ProgressControlData
@{
    ViewData["Title"] = "Fortschrittskontrolle";
}

<style>
    :root {
        --licorice: #141210;
        --pink: #FF0844;
        --white: #FFFFFF;
        --gray-100: #F5F4F2;
        --gray-200: #E8E6E2;
        --gray-400: #9A9690;
        --gray-600: #5C5854;
    }

    .progress-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 24px 80px;
        color: var(--licorice);
    }

    .section-label {
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--pink);
        text-transform: uppercase;
        margin-bottom: 6px;
        font-weight: bold;
    }

    .section-title {
        font-size: 24px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .section-desc {
        font-size: 14px;
        color: var(--gray-600);
        margin-bottom: 26px;
        max-width: 760px;
    }

    .screen {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(20,18,16,.08);
    }

    .page-content {
        padding: 22px 18px;
    }

    .page-titlebar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--gray-200);
    }

    .page-titlebar h2 {
        font-size: 18px;
        margin: 0;
    }

    .role-badge {
        background: #E6F1FB;
        color: #0C447C;
        font-size: 10px;
        padding: 3px 7px;
        border-radius: 4px;
        font-weight: bold;
    }

    .info-box {
        background: var(--gray-100);
        border: 1px solid var(--gray-200);
        border-radius: 7px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .info-label {
        color: var(--gray-600);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 4px;
    }

    .info-value {
        font-weight: bold;
    }

    .lesson-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        margin-top: 10px;
    }

    .lesson-table th {
        text-align: left;
        padding: 8px;
        background: var(--licorice);
        color: var(--white);
        font-size: 12px;
    }

    .lesson-table td {
        padding: 8px;
        border-bottom: 1px solid var(--gray-200);
    }

    .lesson-table tr:last-child td {
        border-bottom: none;
    }

    .note {
        margin-top: 14px;
        font-size: 12px;
        color: var(--gray-600);
    }

    .btn-secondary-storyboard {
        margin-top: 12px;
        padding: 8px 13px;
        border-radius: 5px;
        border: 1px solid var(--gray-200);
        background: var(--gray-100);
        color: var(--licorice);
        cursor: pointer;
        font-size: 13px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-secondary-storyboard:hover {
        background: var(--pink);
        color: var(--white);
        text-decoration: none;
    }
</style>

<div class="progress-page">
    <div class="section-label">Storyboard</div>

    <h1 class="section-title">Fortschrittskontrolle für Mentor</h1>

    <p class="section-desc">
        Der Mentor sieht die Fortschrittsdetails eines ausgewählten Trainees.
        Die Ansicht hilft dabei, schnell zu erkennen, welche Lektionen bereits abgeschlossen sind
        und wo Unterstützung benötigt wird.
    </p>

    <div class="screen">
        <div class="page-content">
            <div class="page-titlebar">
                <h2>Progress of Trainee 1</h2>
                <span class="role-badge">DETAILS</span>
            </div>

            <div class="info-box">
                <div class="info-label">System response</div>
                <div class="info-value">
                    The selected trainee's progress is displayed.
                </div>
            </div>

            <div class="info-box">
                <div class="info-label">Progress Statistics</div>

                <div>Days worked: <strong>@Model.DaysWorked</strong></div>
                <div>Finished estimate: <strong>@Model.Finished</strong></div>
                <div>Open estimate: <strong>@Model.Open</strong></div>
                <div>Buffer: <strong>@Model.Buffer</strong></div>
                <div>Speed: <strong>@Model.Speed %</strong></div>
                <div>Predicted Buffer: <strong>@Model.PredictedBuffer</strong></div>
            </div>

            <table class="lesson-table">
                <thead>
                    <tr>
                        <th>Lesson</th>
                        <th>Status</th>
                        <th>Mentor Note</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Lesson 1</td>
                        <td>Completed</td>
                        <td>No action required</td>
                    </tr>

                    <tr>
                        <td>Lesson 2</td>
                        <td>In Progress</td>
                        <td>Support if questions appear</td>
                    </tr>

                    <tr>
                        <td>Lesson 3</td>
                        <td>Open</td>
                        <td>Check again later</td>
                    </tr>
                </tbody>
            </table>

            <p class="note">
                This view helps the mentor quickly identify where a trainee may need support.
            </p>

            <a class="btn-secondary-storyboard" asp-controller="Mentor" asp-action="Index">
                Back to overview
            </a>
        </div>
    </div>
</div>