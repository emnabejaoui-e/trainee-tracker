@model Trainee_Tracker.Models.ProgressControlData
@{
    ViewData["Title"] = "Fortschrittskontrolle";
}


<div class="progress-page">
    <h1 class="section-title">Progress-Control-Data</h1>


    <div class="screen">
        <div class="page-content">
            <div class="page-titlebar">
                <h2>Progress of Trainee 1</h2>
                <span class="role-badge">DETAILS</span>
            </div>

            <div class="info-box">
                <div class="info-label">System response</div>
                <div class="info-value">
                    The selected trainee's progress is displayed.
                </div>
            </div>

            <div class="info-box">
                <div class="info-label">Progress Statistics</div>

                <div>Days worked: <strong>@Model.DaysWorked</strong></div>
                <div>Finished estimate: <strong>@Model.Finished</strong></div>
                <div>Open estimate: <strong>@Model.Open</strong></div>
                <div>Buffer: <strong>@Model.Buffer</strong></div>
                <div>Speed: <strong>@Model.Speed %</strong></div>
                <div>Predicted Buffer: <strong>@Model.PredictedBuffer</strong></div>
            </div>

      

            <p class="note">
                This view helps the mentor quickly identify where a trainee may need support.
            </p>

            <a class="btn-secondary-storyboard" asp-controller="Mentor" asp-action="Index">
                Back to overview
            </a>
        </div>
    </div>
</div>