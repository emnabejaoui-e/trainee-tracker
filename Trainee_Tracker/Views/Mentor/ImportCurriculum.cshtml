@* Author: Leon *@

@{
    ViewData["Title"] = "Import Curriculum";
}

@model IFormFile

<h1 class="section-title">Lehrplan importieren</h1>

<form method="post" enctype="multipart/form-data">
    @foreach(String curriculumName in @ViewBag.curriculumNames)
    {
        <label>
            <input name="cur" type="radio" value="@curriculumName">
            @curriculumName
        </label>        
    }

    <br>

    <label for="curriculum-file">
        <input id="curriculum-file" type="file" accept="application/json">
    </label>
    
    <button class="btn" type="submit">Hochladen</button>
    
    <br/>

    <span asp-validation-for="FileName"></span>
</form>