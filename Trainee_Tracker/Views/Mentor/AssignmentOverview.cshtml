@using Trainee_Tracker.Models;

@model IEnumerable<Trainee_Tracker.Models.LessonAssignment>

@{
    ViewData["Title"] = "Lesson Assignments Overview";
    ViewData["NavbarOverride"] = "Mentor";
    var traineeName = Model.FirstOrDefault()?.Trainee?.Name ?? "Trainee";

    var statusCounts = Model
    . GroupBy(la => la.Status)
    .ToDictionary(g => g.Key, g => g.Count());

    var allStati = Enum.GetValues(typeof(LessonAssignmentStatus)).Cast<LessonAssignmentStatus>();

    var toReview = Model
    .Where(la=>la.Status == LessonAssignmentStatus.Finished)
    .OrderBy(la =>la.Position)
    .ToList();

    var rejectedAssignments = Model
    .Where(la=>la.Status == LessonAssignmentStatus.Rejected)
    .OrderBy(la => la.Position)
    .ToList();

    var rejectionHistory = ViewBag.RejectionReasons as Dictionary<int, List<Rejection>>;
    var assignmentsWithHistory = ViewBag.AssignmentsWithHistory as List<LessonAssignment>;

    var statusOrder = new[] {"Open", "Started", "Finished", "Rejected", "Accepted", "Rated", "Skipped"};
    var grouped = Model
            .GroupBy(x => x.Status.ToString())
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Position)
            .ToList());
    
    var skippedAssignments = Model
    .Where(a => a.Status == LessonAssignmentStatus.Skipped)
    .OrderBy(a => a.Position)
    .ToList();
}

@if(TempData["Error"] != null){
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<style> 
    .container {
        max-width: 100%;
        padding: 0%;
    }
</style>

<div class="review-container">

    <h1 class="page-title">Lesson Assignments Overview of @traineeName</h1>

    <h2 class="section-title">Overview</h2>

    @* <div class="board-container"> *@

        <div class="board-search">
            <input id="boardSearch" type="text" placeholder="search for a card e.g. Linux or 34" />
        </div>

        <div class="board-columns">
            @foreach(var status in statusOrder)
            {
                var cards = grouped.ContainsKey(status) ? grouped[status] : new List<LessonAssignment>();

                    <div class="board-column column-@status.ToLower()">
                        <div class ="column-header">
                            <span class="column-title">@status</span>
                            <span class="column-count">@cards.Count</span>
                        </div>

                        <div class="column-body" data-status="@status" id="column-body-@status">
                            @if(!cards.Any())
                            {
                                <div class="column-empty">no cards</div>
                            }
                            else
                            {
                                @foreach(var card in cards){
                                    
                                        <div class ="board-card" data-title="@card.Lesson.Title.ToLower()" data-num="@card.Position">
                                            <div class="card-top">
                                                <a class="card-link" href="@card.Lesson.URL">
                                                    <span class="card-title">@card.Lesson.Title</span> 
                                                </a>
                                                
                                            </div> 

                                            <div class="card-bottom-row">
                                                <div class="card-meta">
                                                    <span>#@card.Position</span>
                                                    @if(card.Lesson.Effort != 0){
                                                        <span class="dot"></span>
                                                        <span>@card.Lesson.Effort d</span>
                                                    }
                                                </div>
                                                <div class="card-actions">
                                                @switch(status)
                                                {
                                                    case "Finished":
                                                        <div class="review-item-action">
                                                            <form asp-controller="Mentor" asp-action="Accept" asp-route-assignmentId="@card.Id" method="post" class="inline-form">
                                                                <button type="submit" class="action-btn action-btn-accept">Accept</button>
                                                            </form>
                                                            
                                                            <button type="button" class="action-btn action-btn-reject"
                                                                    onclick="document.getElementById('reject-dialog-@card.Id').showModal()">Reject</button>
                                                            
                                                        </div>
                                                        break;

                                                    default:
                                                        break;
                                                }
                                            </div>
                                        </div>
                                        
                                    </div>
                                    
                                    
                                }
                            }
                        </div>
                    </div>
            }
        </div>
    @* </div> *@

    <h2 class="section-title">Rejected Assignment History</h2>

    @if(assignmentsWithHistory == null || !assignmentsWithHistory.Any()){
        <p class="empty-hint">No lesson assignments are currently rejected</p>
    }
    else
    {   <div class="rejected-list-container" id="rejectedListContainer">
        <ul class="rejected-list">
            @foreach(var assignment in assignmentsWithHistory){
                <li class="rejected-item">
                    <div class="rejected-item-info">
                        <span class="rejected-item-title">@assignment.Lesson.Title</span>
                        <span class="rejected-item-meta">@assignment.Position</span>
                    </div>
                    
                    @if(rejectionHistory != null && rejectionHistory.TryGetValue(assignment.Id, out var history))
                    {
                        <ul class="rejection-history-list">
                            @foreach(var rejection in history)
                            {
                               <li class="rejection-history-item">
                                <strong>@rejection.RejectedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                                <p>@rejection.Reason</p>
                               </li> 
                            }
                        </ul>
                    }
                </li>
            }
        </ul> 
        </div>
    }

    @foreach(var assignment in toReview)
    {
        <dialog id="reject-dialog-@assignment.Id" class="reject-dialog">
            <form asp-controller="Mentor" asp-action="RejectAssignment" asp-route-assignmentId="@assignment.Id" method="post">
                <p class="rejection-dialog-title">Reason for rejecting "@assignment.Lesson.Title":</p>
                <textarea name="reason" required rows="3" placeholder="Reason..."></textarea>
                <div class ="rejection-dialog-action">
                    <button type="button" class="action-btn action-btn-cancel" onclick="document.getElementById('reject-dialog-@assignment.Id').close()">Cancel</button>
                    <button type="submit" class="action-btn action-btn-reject">Reject</button>
                </div>
            </form>
        </dialog>
    }


    <h2 class="section-title">Skip an Assignment</h2>
    <div>
        <button type="button" class="action-btn action-btn-primary" onclick="document.getElementById('skip-select-dialog').showModal()">Choose an Assignment</button>

        <dialog id="skip-select-dialog" class="skip-dialog">
            <h3 class="rejection-dialog-title">Skip an Assignment for @traineeName</h3>
                @{
                    var skippableAssignments = Model
                    .Where(a => a.Status == LessonAssignmentStatus.Open)
                    .OrderBy(a => a.Position)
                    .ToList();
                }

                @if(!skippableAssignments.Any())
                {
                    <p class="skip-select-empty">There is no assignment that can be skipped</p>
                }
                else
                {
                    <ul class="skip-select-list">
                        @foreach(var assignment in skippableAssignments){
                            <li class="skip-select-item">
                                <div class="skip-select-item-info">
                                    <span class="skip-select-postion">@assignment.Position -</span>
                                    <span class="skip-select-title">@assignment.Lesson.Title</span>
                                    <span class="skip-select-status">@assignment.Status</span>
                                </div>

                                <form asp-controller="Mentor" asp-action="SkipAssignment" asp-route-assignmentId="@assignment.Id" method="post">
                                    <button type="submit" class="action-btn action-btn-skip-confirm">skip</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            <div class="rejection-dialog-action">
                <button type="button" class="action-btn action-btn-cancel" onclick="document.getElementById('skip-select-dialog').close()">cancel</button>
            </div>
        </dialog>

    </div>


    <h2 class="section-title">Edit Assignment Order</h2>
    <div>
        <button type="button" class="action-btn action-btn-primary" onclick="document.getElementById('sort-dialog').showModal()">Edit Order</button>

        <dialog id="sort-dialog" class="sort-dialog">
            <h3 class="rejection-dialog-title">Reorder Assignments for @traineeName</h3>
            <form asp-controller="Mentor" asp-action="UpdateAssignmentOrder" method="post" id="sort-form">
                <input type="hidden" name="traineeId" value="@Model.FirstOrDefault()?.TraineeId" />
                <ul id="sortable-list" class="sortable-list">
                    @foreach(var assignment in Model.OrderBy(a => a.Position))
                    {
                        <li class="sortable-item" draggable="true" data-id="@assignment.Id">
                            <span class="drag-handle">⠿</span>
                            <span class="sortable-item-position">@assignment.Position -</span>
                            <span class="sortable-title">@assignment.Lesson.Title</span>
                            <input type="hidden" name="orderedIds" value="@assignment.Id"/>
                        </li>
                    }
                </ul>
                <div class="rejection-dialog-action">
                    <button type="button" class="action-btn action-btn-cancel" onclick="document.getElementById('sort-dialog').close()">cancel</button>
                    <button type="submit" class="action-btn action-btn-accept">save</button>
                </div>
            </form>
        </dialog>
    </div>

    


</div>


@* JavaScript for search *@
<script>
    document.getElementById('boardSearch').addEventListener('input', function(e){

        var query = e.target.value.toLowerCase().trim();

        document.querySelectorAll('.board-card').forEach(function(card){
            var title = card.dataset.title || '';
            var num = card.dataset.num || '';
            var match = !query || title.indexOf(query) !== -1 || num.indexOf(query) !== -1;
            card.style.display = match ? '' : 'none';
        });

        document.querySelectorAll('.board-column').forEach(function(col){
            var visibleCards = col.querySelectorAll('.board-card:not([style*="display: none"])').length;
            var emptyMsg = col.querySelector('.column-empty');
            if(emptyMsg){
                emptyMsg.style.display = (query && visibleCards == 0) ? '' : (visibleCards === 0 && !query ? '' : 'none');
            }
        });

    });

</script>

@* JavaScript for drag-&-drop *@
<script>
    (function() {
        const list = document.getElementById('sortable-list');
        let dragged = null;

        list.addEventListener('dragstart', e => {
            dragged = e.target.closest('.sortable-item');
            dragged.classList.add('dragging');
        });

        list.addEventListener('dragend', () => {
            dragged?.classList.remove('dragging');
            dragged = null;
        });

        list.addEventListener('dragover', e => {
            e.preventDefault();
            const target = e.target.closest('.sortable-item');
            if(!target || target == dragged) return;

            const rect = target.getBoundingClientRect();
            const after = (e.clientY - rect.top) > rect.height / 2;
            list.insertBefore(dragged, after ? target.nextSibling : target);
        });

    })();
</script>

@* JavaScript for saving position when scrolling *@
<script>
    (function () {
        function persistScroll(elementId){
            const el = document.getElementById(elementId);
            if(!el) return;
            const key = 'scrollPosition:' + window.location.pathname + ':' + elementId;
            const saved = sessionStorage.getItem(key);
            if(saved !== null){
                el.scrollTop = parseInt(saved, 10);
            }
            let timeout;
            el.addEventListener('scroll', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => sessionStorage.setItem(key, el.scrollTop), 100);
            });
        }

        persistScroll('rejectedListContainer');
        persistScroll('column-body-Open');
        persistScroll('column-body-Started');
        persistScroll('column-body-Finished');
        persistScroll('column-body-Rejected');
        persistScroll('column-body-Accepted');
        persistScroll('column-body-Rated');
        persistScroll('column-body-Skipped');
    })();
</script>