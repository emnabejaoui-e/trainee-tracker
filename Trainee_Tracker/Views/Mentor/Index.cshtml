@* Code Owner: Jelena Cosic *@
@{
    ViewData["Title"] = "Dashboard";
    var name  = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Mentor";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}
<div class="container" style="margin-top: 40px;">
    <h2>Hello, @name!</h2>
    <p>@email</p>
    <p>You'll soon see an overview of the trainees assigned to you here.</p>
    @if (User.IsInRole("Admin"))
    {
        <a href="/Admin/Index"
           style="margin-top: 16px; display: inline-block; padding: 11px 28px; background-color: #141210; color: #FFFFFF; border-radius: 6px; font-family: 'League Spartan', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; font-size: 14px;">
            Back to Admin View
        </a>
    }
</div>