@using Trainee_Tracker.Controllers
@using Trainee_Tracker.Models

@* Code-Owner: Julia Sandner *@

@model IEnumerable<Trainee_Tracker.Models.LessonAssignment>

@{
    ViewData ["Title"] = "Lesson Board";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var total = Model.Count();
    var done = Model.Count(la => la.Status == LessonAssignmentStatus.Finished || la.Status == LessonAssignmentStatus.Accepted || la.Status == LessonAssignmentStatus.Rated);
    var progress = total > 0 ? (int) ((double)done / total * 100) : 0;

    var statusOrder = new[] {"Open", "Started", "Finished", "Rejected", "Accepted", "Rated"};
    var grouped = Model
            .GroupBy(x => x.Status.ToString())
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Position).ToList());

    var rejectedAssignments = Model
    .Where(la=>la.Status == LessonAssignmentStatus.Rejected)
    .OrderBy(la => la.Position)
    .ToList();

    var rejectionHistory = ViewBag.RejectionReasons as Dictionary<int, List<Rejection>>;
    var assignmentsWithHistory = ViewBag.AssignmentsWithHistory as List<LessonAssignment>;
}

@if(TempData["Error"] != null){
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<style> 
    .container {
        max-width: 100%;
        padding: 0%;
    }
</style>   



<div class="board-container">
    <div class="page-title">Lessons</div>
    <div class="lesson-subtitle">Your learning path - @done of @total completed</div>

    <div class="progress-bar">
        <div class="progress-fill" style="width: @progress%"></div>
    </div>

    <div class="board-search">
        <input id="boardSearch" type="text" placeholder="search for a card e.g. Linux or 34" />
    </div>

    <div class="board-columns">
        @foreach(var status in statusOrder)
        {
            var cards = grouped.ContainsKey(status) ? grouped[status] : new List<LessonAssignment>();

                <div class="board-column column-@status.ToLower()">
                    <div class ="column-header">
                        <span class="column-title">@status</span>
                        <span class="column-count">@cards.Count</span>
                    </div>

                    <div class="column-body" data-status="@status" id="column-body-@status">
                        @if(!cards.Any())
                        {
                            <div class="column-empty">no cards</div>
                        }
                        else
                        {
                            @foreach(var card in cards){
                                
                                    <div class ="board-card" data-title="@card.Lesson.Title.ToLower()" data-num="@card.Position">
                                        <div class="card-top">
                                            <a class="card-link" href="@card.Lesson.URL">
                                                <span class="card-title">@card.Lesson.Title</span> 
                                            </a>
                                            
                                        </div> 

                                        <div class="card-bottom-row">
                                            <div class="card-meta">
                                                <span>#@card.Position</span>
                                                @if(card.Lesson.Effort != 0){
                                                    <span class="dot"></span>
                                                    <span>@card.Lesson.Effort d</span>
                                                }
                                            </div>
                                            <div class="card-actions">
                                            @switch(status)
                                            {
                                                case "Open":
                                                    <form asp-action="StartAssignment" asp-controller="LessonBoard" asp-route-assignmentId="@card.Id" method="post">
                                                        <input type="hidden" name="assignmentId" value="@card.Id"/>
                                                        <button type="submit" class="action-btn action-btn-primary">start</button>
                                                    </form>
                                                    break;

                                                case "Started":
                                                    <form asp-action="OpenAssignment" asp-controller="LessonBoard" asp-route-assignmentId="@card.Id" method="post">
                                                        <input type="hidden" name="assignmentId" value="@card.Id"/>
                                                        <button type="submit" class="action-btn action-btn-primary-open">open</button>
                                                    </form>

                                                    <form asp-action="FinishAssignment" asp-controller="LessonBoard" asp-route-assignmentId="@card.Id" method="post">
                                                        <input type="hidden" name="assignmentId" value="@card.Id"/>
                                                        <button type="submit" class="action-btn action-btn-primary-finish">finish</button>
                                                    </form>
                                                    break;

                                                case "Finished":
                                                    <form asp-action="StartAssignment" asp-controller="LessonBoard" asp-route-assignmentId="@card.Id" method="post">
                                                        <input type="hidden" name="assignmentId" value="@card.Id" />
                                                        <button type="submit" class="action-btn action-btn-primary">start</button>
                                                    </form>
                                                    
                                                    break;

                                                case "Accepted":
                                                        <a asp-controller="Feedback" asp-action="CreateFeedback" asp-route-assignmentId="@card.Id" asp-route-lessonId="@card.Lesson.Id" class="action-btn action-btn-primary">rate</a>
                                                    break;

                                                case "Rejected":
                                                    <form asp-action="StartAssignment" asp-controller="LessonBoard" asp-route-asssignmentId="@card.Id" method="post">
                                                        <input type="hidden" name="assignmentId" value="@card.Id"/>
                                                        <button type="submit" class="action-btn action-btn-primary">restart</button>
                                                    </form>
                                                    break;

                                                default:
                                                    break;
                                            }
                                        </div>
                                    </div>
                                       
                                </div>
                                   
                                
                            }
                        }
                    </div>
                </div>
        }
    </div>

    <h2 class="section-title">Rejected Assignment History</h2>
    <div class="rejected-list-container">
    @if(assignmentsWithHistory == null || !assignmentsWithHistory.Any()){
        <p class="empty-hint">No lesson assignments are rejected</p>
    }
    else
    {   
        <ul class="rejected-list">
            @foreach(var assignment in assignmentsWithHistory){
                <li class="rejected-item">
                    <div class="rejected-item-info">
                        <span class="rejected-item-title">@assignment.Lesson.Title</span>
                        <span class="rejected-item-meta">@assignment.Position</span>
                    </div>
                    
                    @if(rejectionHistory != null && rejectionHistory.TryGetValue(assignment.Id, out var history))
                    {
                        <ul class="rejection-history-list">
                            @foreach(var rejection in history)
                            {
                               <li class="rejection-history-item">
                                <strong>@rejection.RejectedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong>
                                <p>@rejection.Reason</p>
                               </li> 
                            }
                        </ul>
                    }
                </li>
            }
        </ul> 
        
    }
    </div>

    @if(ViewBag.HasAcceptedAssignmentWithoutFeedback)
    {   
        <dialog id="feedback-reminder-dialog" class="feedback-reminder-dialog">
            <p class="feedback-reminder-dialog-title">Your assignment "@ViewBag.AcceptedAssignmentTitle" has been accepted!
                Would you like to provide feedback on this now?
            </p>
            <div class="feedback-reminder-dialog-actions">
                <button type="button" id="feedback-dialog-close" class="action-btn-cancel">Not now</button>
                <a asp-controller="Feedback" asp-action="CreateFeedback" asp-route-assignmentId="@ViewBag.AcceptedAssignmentId" asp-route-lessonId="@ViewBag.AcceptedAssignmentLessonId" class="action-btn action-btn-giveFeedback">rate</a>
            </div>
        </dialog>

    }
</div>

@* JavaScript for serach *@
<script>
    document.getElementById('boardSearch').addEventListener('input', function(e){

        var query = e.target.value.toLowerCase().trim();

        document.querySelectorAll('.board-card').forEach(function(card){
            var title = card.dataset.title || '';
            var num = card.dataset.num || '';
            var match = !query || title.indexOf(query) !== -1 || num.indexOf(query) !== -1;
            card.style.display = match ? '' : 'none';
        });

        document.querySelectorAll('.board-column').forEach(function(col){
            var visibleCards = col.querySelectorAll('.board-card:not([style*="display: none"])').length;
            var emptyMsg = col.querySelector('.column-empty');
            if(emptyMsg){
                emptyMsg.style.display = (query && visibleCards == 0) ? '' : (visibleCards === 0 && !query ? '' : 'none');
            }
        });

    });
</script>

@* JavaScript for saving position when scrolling *@
<script>
    (function () {
        function persistScroll(elementId){
            const el = document.getElementById(elementId);
            if(!el) return;
            const key = 'scrollPosition:' + window.location.pathname + ':' + elementId;
            const saved = sessionStorage.getItem(key);
            if(saved !== null){
                el.scrollTop = parseInt(saved, 10);
            }
            let timeout;
            el.addEventListener('scroll', () => {
                clearTimeout(timeout);
                timeout = setTimeout(() => sessionStorage.setItem(key, el.scrollTop), 100);
            });
        }

        persistScroll('column-body-Open');
        persistScroll('column-body-Started');
        persistScroll('column-body-Finished');
        persistScroll('column-body-Rejected');
        persistScroll('column-body-Accepted');
        persistScroll('column-body-Rated');

    })();
</script>

@* JavaScript for Rate-Reminder-Dialog *@
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dialog = document.getElementById("feedback-reminder-dialog");
        dialog.showModal();
        document.getElementById("feedback-dialog-close").addEventListener("click", () => {dialog.close(); });

    });
</script>