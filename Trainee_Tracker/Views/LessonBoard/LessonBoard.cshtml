@using Trainee_Tracker.Models

@* Hauptverantwortlich: Julia *@

@model IEnumerable<Trainee_Tracker.Models.LessonAssignment>

@{
    ViewData ["Title"] = "Lesson Board";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/lessonBoard_syle.css" /> 
<style> 
    .container {
        max-width: 100%;
        padding: 0%;
    }
</style>   

<main class="board">

    @* Open-Spalte *@
    <div class="column" id="open">
        <h2>Open<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Open)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Open))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>
                
                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                    <form method="post" asp-action="UpdateStatus" asp-controller="LessonBoard">
                        <input type="hidden" name="id" value="@assignment.Id"/>
                        <input type="hidden" name="newStatus" value="@LessonAssignmentStatus.Started"/>
                        <button type="submit" class="btn btn-status">start</button>
                        
                    </form>
                </div>
                
            </div>
        }
    </div>

    @* Started-Spalte *@
    <div class="column" id="started">
        <h2>Started<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Started)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Started))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>

                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                    <form method="post" asp-action="UpdateStatus" asp-controller="LessonBoard">
                        <input type="hidden" name="id" value="@assignment.Id"/>
                        <input type="hidden" name="newStatus" value="@LessonAssignmentStatus.Finished"/>
                        <button type="submit" class="btn btn-status">finish</button>
                        
                    </form>
                </div>
            </div>
        }
    </div>

    @* Finished-Spalte *@
    <div class="column" id="finished">
        <h2>Finished<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Finished)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Finished))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>
                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                </div>
            </div>
        }
    </div>

    @* Accepted-Spalte *@
    <div class="column" id="accepted">
        <h2>Accepted<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Accepted)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Accepted))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>

                
                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                    <form method="post" asp-action="UpdateStatus" asp-controller="LessonBoard">
                        <input type="hidden" name="id" value="@assignment.Id"/>
                        <input type="hidden" name="newStatus" value="@LessonAssignmentStatus.Rated"/>
                        <button type="submit" class="btn btn-status">rate</button>
                        
                    </form>
                </div>
            </div>
        }
    </div>

    @* Rejected-Spalte *@
    <div class="column" id="rejected">
        <h2>Rejected<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Rejected)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Rejected))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>

                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                    <form method="post" asp-action="UpdateStatus" asp-controller="LessonBoard">
                        <input type="hidden" name="id" value="@assignment.Id"/>
                        <input type="hidden" name="newStatus" value="@LessonAssignmentStatus.Started"/>
                        <button type="submit" class="btn btn-status">restart</button>
                        
                    </form>
                </div>
            </div>
        }
    </div>

    @* Rated-Spalte *@
    <div class="column" id="rated">
        <h2>Rated<span class="card-count">@Model.Count(l => l.Status == LessonAssignmentStatus.Rated)</span></h2>
        @foreach(var assignment in Model.Where(l => l.Status == LessonAssignmentStatus.Rated))
        {
            <div class="card" data-id="@assignment.Id">
                <div class="card-header">
                    <h3 class="card-title">@assignment.Position - @assignment.Lesson.Title</h3>
                    <span class="card-duration-badge">@assignment.Lesson.Effort Day(s)</span>
                </div>

                <div class="card-actions">
                    <a href="@assignment.Lesson.URL" class="btn btn-see-card" target="_blank">see card</a>
                </div>
            </div>
        }
    </div>
</main>



