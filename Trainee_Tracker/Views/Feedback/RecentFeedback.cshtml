@* Code-Owner: Emna Bejaoui *@
@model IEnumerable<Trainee_Tracker.Models.LessonFeedback>

@{
    ViewData["Title"] = "Recent Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/feedback.css" />

<h1 class="section-title">Recent Feedback</h1>

<form asp-action="RecentFeedback" method="get" class="feedback-filter">
    <div>
        <label for="from">From</label>
        <input type="date" id="from" name="from" value="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" />

    </div>

    <div>
        <label for="until">Until</label>
        <input type="date" id="until" name="until" value="@(ViewBag.Until != null ? ((DateTime)ViewBag.Until).ToString("yyyy-MM-dd") : "")" />
    </div>

    <button type="submit" class="btn">Show Feedback</button>
</form>

@if (Context.Request.Query.ContainsKey("from") && Context.Request.Query.ContainsKey("until") && !Model.Any())
{
    <p>No feedback found for the selected period.</p>
}
else
{
    <div class="activity-feed">
        @foreach (var feedback in Model)
        {
            <article>
                <header class="feedback-card-header">
                    <span class="float-left">
                        <span><i>Missing Name</i></span>
                        <span>rated</span>
                    </span>

                    <span class="float-right">
                        <button type="button" class="btn">Edit</button>
                        <button type="button" class="btn btn-secondary">Delete</button>
                    </span>
                </header>

                <h2>Card X</h2>

                <dl>
                    <dt>Difficulty</dt>
                    <dd class="rating" aria-label="@feedback.Difficulty out of 5 stars">
                        @for (var i = 0; i < feedback.Difficulty; i++)
                        {
                            <span aria-hidden="true">★</span>
                        }
                        @for (var i = feedback.Difficulty; i < 5; i++)
                        {
                            <span aria-hidden="true">☆</span>
                        }
                    </dd>

                    <dt>Previous Knowledge</dt>
                    <dd>@feedback.PriorKnowledge</dd>

                    <dt>Actual Effort</dt>
                    <dd>@feedback.ActualEffort days</dd>

                    <dt>Comment</dt>
                    <dd>@feedback.Comment</dd>
                </dl>
            </article>
        }
    </div>
}