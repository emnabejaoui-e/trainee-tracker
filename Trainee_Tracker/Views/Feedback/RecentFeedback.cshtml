@* Code-Owner: Emna Bejaoui *@
@model IEnumerable<Trainee_Tracker.Models.LessonFeedback>
@using System.Security.Claims
@{
    ViewData["Title"] = "Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var editableFeedbackIds = ViewBag.EditableFeedbackIds as HashSet<int> ?? new HashSet<int>();
    var currentUserId = int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
}

<link rel="stylesheet" href="~/css/feedback.css" />

<h1 class="section-title">
    <i class="bi bi-chat-square-text"></i>
    Feedback
</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="feedback-show-filter">
    <a  asp-action="RecentFeedback"
        asp-route-show="all"
        asp-route-from="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")"
        asp-route-until="@(ViewBag.Until != null ? ((DateTime)ViewBag.Until).ToString("yyyy-MM-dd") : "")"
        class="filter-tab @(ViewBag.Show == "all" ? "active" : "")">
            All Feedback
    </a>

    @if (User.IsInRole("Trainee"))
    {
        <a asp-action="RecentFeedback"
            asp-route-show="mine"
            asp-route-from="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")"
            asp-route-until="@(ViewBag.Until != null ? ((DateTime)ViewBag.Until).ToString("yyyy-MM-dd") : "")"
            class="filter-tab @(ViewBag.Show == "mine" ? "active" : "")">
                My Feedback
        </a>
    }

    @if (User.IsInRole("Mentor") )
    {
        <a asp-action="RecentFeedback"
            asp-route-show="assigned"
            asp-route-from="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")"
            asp-route-until="@(ViewBag.Until != null ? ((DateTime)ViewBag.Until).ToString("yyyy-MM-dd") : "")"
            class="filter-tab @(ViewBag.Show == "assigned" ? "active" : "")">
                My Trainees
        </a>
    }

</div>


<form asp-action="RecentFeedback" method="get" class="feedback-filter">
    <input type="hidden" name="show" value="@ViewBag.Show" />
    <div>
        <label for="from">From</label>
        <input  type="date"
                id="from"
                name="from"
                value="@(ViewBag.From != null ? ((DateTime)ViewBag.From).ToString("yyyy-MM-dd") : "")" />
    </div>

    <div>
        <label for="until">Until</label>
        <input type="date"
                id="until"
                name="until"
                value="@(ViewBag.Until != null ? ((DateTime)ViewBag.Until).ToString("yyyy-MM-dd") : "")" />
    </div>

    <button type="submit" class="btn">Show Feedback</button>
</form>


@if (ViewBag.DateError != null)
{
    <p class="text-danger">@ViewBag.DateError</p>
}

@if (Context.Request.Query.ContainsKey("from") &&
    Context.Request.Query.ContainsKey("until") &&
    !Model.Any() &&
    ViewData.ModelState.IsValid)
{
    <p>No feedback found for the selected period.</p>
}
else
{
    <div class="activity-feed">
        @foreach (var feedback in Model)
        {
            <article>
                <header class="feedback-card-header">
                    <div class="feedback-card-title">
                        <h2>@(feedback.Lesson?.Title ?? "Unknown Lesson")</h2>

                        <p class="feedback-date">
                            Submitted on @feedback.CreatedAt.ToString("dd.MM.yyyy 'at' HH:mm")
                        </p>

                        <p class="feedback-author">
                            Rated by <i>@(feedback.Trainee?.Name ?? "Unknown Trainee")</i>
                        </p>
                    </div>

                    <div class="feedback-actions">
                        @if
                            (editableFeedbackIds.Contains(feedback.Id))
                        {
                            <a asp-action="Edit"
                                asp-route-id="@feedback.Id"
                                class="btn">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                method="post"
                                onsubmit="return confirm('Are you sure you want to delete this feedback?');">
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                        name="id"
                                        value="@feedback.Id" />

                                <button type="submit"
                                        class="btn btn-secondary">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </header>

                <dl>
                    <dt>Difficulty</dt>

                    @if (feedback.Difficulty.HasValue)
                    {
                        <dd class="rating-details">
                            <div class="rating"
                                aria-label="@feedback.Difficulty.Value out of 5 stars">
                                @for (var i = 0; i < feedback.Difficulty.Value; i++)
                                {
                                    <span aria-hidden="true">★</span>
                                }

                                @for (var i = feedback.Difficulty.Value; i < 5; i++)
                                {
                                    <span aria-hidden="true">☆</span>
                                }
                            </div>

                            <span class="rating-description">
                                @(feedback.Difficulty.Value switch
                                {
                                    1 => "Very easy",
                                    2 => "Easy",
                                    3 => "Moderate",
                                    4 => "Difficult",
                                    5 => "Very difficult",
                                    _ => ""
                                })
                            </span>
                        </dd>
                    }
                    else
                    {
                        <dd class="empty-feedback-value">No rating</dd>
                    }

                    <dt>Previous Knowledge</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(feedback.PriorKnowledge)
                            ? "No information"
                            : feedback.PriorKnowledge)
                    </dd>

                    <dt>Actual Effort</dt>
                    <dd>
                        @(feedback.ActualEffort.HasValue
                            ? $"{feedback.ActualEffort} hours"
                            : "No information")
                    </dd>

                    <dt>Comment</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(feedback.Comment)
                            ? "No comment"
                            : feedback.Comment)
                    </dd>
                </dl>
            </article>
        }
    </div>
}