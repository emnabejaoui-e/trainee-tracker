@* Code-Owner: Emna Bejaoui *@
@model Trainee_Tracker.Models.LessonFeedback

@{
    ViewData["Title"] = "Create Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/feedback.css" />

<div class="feedback-page">
    <h1 class="feedback-title">Create Feedback</h1>

    <div class="feedback-card">
        <div class="badge">COMPLETED</div>

        <h2 class="lesson-title">@ViewBag.LessonTitle</h2>

        <p class="feedback-description">
            Please rate the lesson and provide feedback about your learning experience.
        </p>

        <form asp-action="CreateFeedback" asp-controller="Feedback" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="AssignmentId" />

            <div class="feedback-box">
                <label>
                    Difficulty (optional)
                </label>

                <div class="rating-input" aria-label="Difficulty rating">
                    <input asp-for="Difficulty" type="radio" id="star5" value="5" />
                    <label for="star5"
                            data-tooltip="Very difficult"
                            aria-label="5 stars: very difficult">★</label>

                    <input asp-for="Difficulty" type="radio" id="star4" value="4" />
                    <label for="star4"
                            data-tooltip="Difficult"
                            aria-label="4 stars: difficult">★</label>

                    <input asp-for="Difficulty" type="radio" id="star3" value="3" />
                    <label for="star3"
                            data-tooltip="Moderate"
                            aria-label="3 stars: moderate">★</label>

                    <input asp-for="Difficulty" type="radio" id="star2" value="2" />
                    <label for="star2"
                            data-tooltip="Easy"
                            aria-label="2 stars: easy">★</label>

                    <input asp-for="Difficulty" type="radio" id="star1" value="1" />
                    <label for="star1"
                            data-tooltip="Very easy"
                            aria-label="1 star: very easy">★</label>
                </div>

                <span asp-validation-for="Difficulty" class="text-danger"></span>
            </div>

            <div class="feedback-box">
                <label asp-for="PriorKnowledge">
                    Previous Knowledge (optional)
                </label>

                <select asp-for="PriorKnowledge">
                    <option value="">Select...</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                </select>

                <span asp-validation-for="PriorKnowledge" class="text-danger"></span>
            </div>

            <div class="feedback-box">
                <label asp-for="ActualEffort">
                    Actual Effort in hours (optional)
                </label>

                <input  asp-for="ActualEffort"
                        type="number"
                        step="0.5"
                        min="0.5"
                        placeholder="e.g. 1.5" />

                <span asp-validation-for="ActualEffort" class="text-danger"></span>
            </div>

            <div class="feedback-box">
                <label asp-for="Comment">
                    Comment (optional)
                </label>

                <textarea asp-for="Comment"></textarea>

                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit-feedback">
                Submit Feedback
            </button>

            <div asp-validation-summary="All" class="text-danger"></div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}