@model IEnumerable<Trainee_Tracker.Models.LessonFeedback>

@{
    ViewData["Title"] = "My Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/feedback.css" />

<h1 class="section-title">My Feedback</h1>

@if (!Model.Any())
{
    <p>You have not submitted any feedback yet.</p>
}
else
{
    <div class="activity-feed">
        @foreach (var feedback in Model)
        {
            <article>
                <header class="feedback-card-header">
                    <span class="float-left"></span>

                    <span class="float-right">
                        <a asp-action="Edit"
                           asp-route-id="@feedback.Id"
                           class="btn">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this feedback?');">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@feedback.Id" />

                            <button type="submit"
                                    class="btn btn-secondary">
                                Delete
                            </button>
                        </form>
                    </span>
                </header>

                <h2>@(feedback.Lesson?.Title ?? "Unknown Lesson")</h2>

                <p class="feedback-date">
                    Submitted: @feedback.CreatedAt.ToString("dd.MM.yyyy, HH:mm")
                </p>

                <dl>
                    <dt>Difficulty</dt>
                    <dd class="rating">
                        @for (var i = 0; i < feedback.Difficulty; i++)
                        {
                            <span>★</span>
                        }

                        @for (var i = feedback.Difficulty; i < 5; i++)
                        {
                            <span>☆</span>
                        }
                    </dd>

                    <dt>Previous Knowledge</dt>
                    <dd>@feedback.PriorKnowledge</dd>

                    <dt>Actual Effort</dt>
                    <dd>@feedback.ActualEffort days</dd>

                    <dt>Comment</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(feedback.Comment)
                            ? "No comment"
                            : feedback.Comment)
                    </dd>
                </dl>
            </article>
        }
    </div>
}