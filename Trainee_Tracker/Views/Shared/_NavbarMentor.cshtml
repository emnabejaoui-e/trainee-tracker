@* Controllernamen usw müssen noch angepasst werden *@
@using System.Security.Claims
<header class="page-header" data-testid="navbar-mentor">
  <div style="display: flex; align-items: center; gap: 50px;">
    <div class="brand">
      <img src="~/images/makandra_word_white_color_rgb.png" alt="makandra" style="height: 15px; margin-top: -7px;">
      <span>cards</span>
      <span style="color:var(--gray-400);font-weight:300;padding-left: 30px;">|</span>
    </div>
    <div class="categories">
      <a asp-controller="Mentor" asp-action="MyTrainees">MY TRAINEES</a>
      <a asp-controller="Feedback" asp-action="RecentFeedback">FEEDBACK</a>
      <a asp-controller="Mentor" asp-action="ImportCurriculum">IMPORT</a>
      <a asp-controller="Mentor" asp-action="Fortschrittskontrolle">PROGRESS</a>
    </div>
  </div>
  <div class="user-profile">
    <span class="role">MENTOR</span>
    <span class="email">@User.FindFirst(ClaimTypes.Email)?.Value</span>
    <div class="user-dropdown">
      <div class="dropdown-btn-container">
        <a asp-controller="Profile" asp-action="Index" class="dropdown-btn">My Profile</a>
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/Index" class="dropdown-btn">Switch to Admin View</a>
        }
        <form method="post" asp-controller="Login" asp-action="Logout" style="margin:0;">
          @Html.AntiForgeryToken()
          <button type="submit" class="dropdown-btn">Log out</button>
        </form>
      </div>
    </div>
  </div>
</header>
