@* Code Owner: Jelena Cosic *@
@using System.Security.Claims
<header class="page-header">
  <div style="display: flex; align-items: center; gap: 50px;">
    <div class="brand">
      <img src="~/images/makandra_word_white_color_rgb.png" alt="makandra" style="height: 15px; margin-top: -7px;">
      <span>cards</span>
      <span style="color:var(--gray-400);font-weight:300;padding-left: 30px;">|</span>
    </div>
    <div class="categories">
      <a asp-controller="Admin" asp-action="UserManagement">USER-MANAGEMENT</a>
    </div>
  </div>
  <div class="user-profile">
    <span class="role">@User.FindFirst(ClaimTypes.Role)?.Value?.ToUpper()</span>
    <span class="email">@User.FindFirst(ClaimTypes.Email)?.Value</span>
    <div class="user-dropdown">
      <div style="display:flex;flex-direction:column;gap:6px;padding:8px;">
        <a asp-controller="Profile" asp-action="Index"
           style="display:block;width:100%;padding:8px 16px;background:#FF0844;color:#fff;text-decoration:none;font-family:'League Spartan',sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border-radius:4px;text-align:center;box-sizing:border-box;">
          My Profile
        </a>
        <a href="/Mentor/Index"
           style="display:block;width:100%;padding:8px 16px;background:#FF0844;color:#fff;text-decoration:none;font-family:'League Spartan',sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;border-radius:4px;text-align:center;box-sizing:border-box;">
          Switch to Mentor View
        </a>
        <form method="post" asp-controller="Login" asp-action="Logout" style="margin:0;">
          @Html.AntiForgeryToken()
          <button type="submit"
                  style="width:100%;background:#FF0844;color:#fff;border:none;border-radius:4px;padding:8px 16px;font-family:'League Spartan',sans-serif;font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;cursor:pointer;">
            Log out
          </button>
        </form>
      </div>
    </div>
  </div>
</header>