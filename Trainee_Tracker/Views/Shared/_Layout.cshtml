<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] – Trainee Tracker</title>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --licorice: #141210;
            --pink: #FF0844;
            --white: #FFFFFF;
            --gray-50: #FAFAF8;
            --gray-100: #F5F4F2;
            --gray-200: #E8E6E2;
            --gray-400: #9A9690;
            --gray-600: #5C5854;
            --success: #1D9E75;
            --success-light: #E1F5EE;
            --warning: #BA7517;
            --danger: #E24B4A;
            --danger-light: #FCEBEB;
            --blue: #185FA5;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Open Sans', sans-serif;
            background: var(--gray-100);
            color: var(--licorice);
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3 {
            font-family: 'League Spartan', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        nav {
            background: var(--licorice);
            border-bottom: 3px solid var(--pink);
            height: 56px;
            display: flex;
            align-items: center;
            padding: 0 36px;
            position: sticky;
            top: 0;
            z-index: 50;
            flex-shrink: 0;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .nav-logo-diamond-wrap {
            width: 28px;
            height: 28px;
            background: var(--pink);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-logo-diamond {
            width: 10px;
            height: 10px;
            background: var(--white);
            transform: rotate(45deg);
            border-radius: 1px;
        }

        .nav-cards-label {
            font-family: 'League Spartan', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            color: var(--white);
            letter-spacing: 0.12em;
            border-left: 1px solid rgba(255,255,255,.2);
            padding-left: 10px;
        }

        .nav-spacer { flex: 1; }

        .nav-links { display: flex; align-items: center; }

        .nav-link {
            font-size: 13px;
            font-weight: 600;
            color: var(--gray-400);
            padding: 0 16px;
            height: 56px;
            display: flex;
            align-items: center;
            text-decoration: none;
            transition: color .15s;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            letter-spacing: 0.01em;
        }

        .nav-link:hover { color: var(--white); }
        .nav-link.active { color: var(--white); border-bottom: 3px solid var(--pink); }

        .nav-divider {
            width: 1px;
            height: 28px;
            background: rgba(255,255,255,.12);
            margin: 0 6px;
        }

        .nav-profile {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            line-height: 1.3;
            padding: 0 0 0 14px;
        }

        .nav-profile .role {
            font-family: 'League Spartan', sans-serif;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--white);
        }

        .nav-profile .email {
            font-size: 10px;
            color: var(--gray-400);
        }

        .nav-signout-form { margin-left: 12px; }

        .nav-signout {
            font-size: 11px;
            font-weight: 600;
            color: var(--gray-600);
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 4px;
            padding: 5px 12px;
            cursor: pointer;
            background: transparent;
            transition: color .15s, border-color .15s;
            white-space: nowrap;
            font-family: 'Open Sans', sans-serif;
        }

        .nav-signout:hover { color: var(--white); border-color: var(--gray-400); }

        main {
            flex: 1;
            max-width: 860px;
            margin: 0 auto;
            width: 100%;
            padding: 40px 24px 70px;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav>
        <a class="nav-logo" href="/">
            <div class="nav-logo-diamond-wrap"><div class="nav-logo-diamond"></div></div>
            <span class="nav-cards-label">Trainee Tracker</span>
        </a>

        <div class="nav-spacer"></div>

        <div class="nav-links">
            @await RenderSectionAsync("NavLinks", required: false)

            <div class="nav-divider"></div>

            <div class="nav-profile">
                <span class="role">
                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Mentor") ? "Mentor" : "Trainee")
                </span>
                <span class="email">
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                </span>
            </div>

            <form class="nav-signout-form" method="post" action="/Login/Logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-signout">Abmelden</button>
            </form>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>