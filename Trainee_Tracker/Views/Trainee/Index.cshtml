@{
    ViewData["Title"] = "Dashboard";
    var name  = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Trainee";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}

<div class="container" style="margin-top: 40px;">
    <h2>Hello, @name!</h2>
    <p>@email</p>
    <p>You'll soon be able to see your current learning progress here.</p>
</div>