@* Code Owner: Jelena Cosic *@
@{
    ViewData["Title"] = "Dashboard";
    var name  = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Trainee";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}

<div class="page-title">Dashboard</div>
<div class="page-subtitle">Willkommen zurück, @name.</div>

<div class="welcome-banner">
    <div>
        <h2>Hallo, @name!</h2>
        <p>@email</p>
    </div>
    <span class="welcome-badge">Trainee</span>
</div>

<div class="section-card">
    <div class="section-card-title">Dein Fortschritt</div>
    <p>Hier siehst du bald deinen aktuellen Lernfortschritt.</p>
</div>